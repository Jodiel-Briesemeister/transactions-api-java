# Copy to .env and adjust. The app reads .env through spring-dotenv, the same way the
# Node version reads it through dotenv. Real deployments should use real environment
# variables instead of a file.

# Server
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=transactions
DB_SCHEMA=public
DB_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT — required, the app refuses to start without it.
# Must be at least 32 characters: it is the HMAC-SHA256 signing key.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# CORS — comma separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Rate limiting (per IP, per window)
RATE_LIMIT_GLOBAL_TRIES=100
RATE_LIMIT_AUTH_TRIES=50
RATE_LIMIT_LOGIN_TRIES=10
RATE_LIMIT_WINDOW_MINUTES=15

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
LOG_LEVEL=INFO
